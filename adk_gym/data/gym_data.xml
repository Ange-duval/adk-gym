<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data noupdate="1">
		<!-- Niveaux de pratique -->
		<record id="level_debutant" model="adk.gym.practice.level">
			<field name="name">Débutant</field>
			<field name="sequence">10</field>
		</record>
		<record id="level_intermediaire" model="adk.gym.practice.level">
			<field name="name">Intermédiaire</field>
			<field name="sequence">20</field>
		</record>
		<record id="level_avance" model="adk.gym.practice.level">
			<field name="name">Avancé</field>
			<field name="sequence">30</field>
		</record>

		<!-- Objectifs sportifs -->
		<record id="obj_perte_poids" model="adk.gym.objective">
			<field name="name">Perte de poids</field>
		</record>
		<record id="obj_musculation" model="adk.gym.objective">
			<field name="name">Musculation / Prise de masse</field>
		</record>
		<record id="obj_cardio" model="adk.gym.objective">
			<field name="name">Cardio / Endurance</field>
		</record>

		<!-- Disciplines -->
		<record id="activity_musculation" model="adk.gym.activity">
			<field name="name">Musculation</field>
			<field name="duration_minutes">60</field>
		</record>
		<record id="activity_cardio" model="adk.gym.activity">
			<field name="name">Cardio Training</field>
			<field name="duration_minutes">45</field>
		</record>
		<record id="activity_yoga" model="adk.gym.activity">
			<field name="name">Yoga</field>
			<field name="duration_minutes">60</field>
		</record>
	</data>
</odoo>
