		<field name="model">adk.gym.objective</field>
		<field name="arch" type="xml">
			<list string="Objectifs" editable="bottom">
				<field name="name"/>
				<field name="description"/>
			</list>
		</field>
	</record>

	<record id="view_gym_objective_form" model="ir.ui.view">
		<field name="name">adk.gym.objective.form</field>
		<field name="model">adk.gym.objective</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<group>
						<field name="name"/>
						<field name="description"/>
