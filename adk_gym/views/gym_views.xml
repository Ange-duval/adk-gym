	<!-- ========================================================== -->
	<!-- PROGRAMMES D'ENTRAÎNEMENT -->
	<!-- ========================================================== -->
	<record id="action_gym_program" model="ir.actions.act_window">
		<field name="name">Programmes d'Entraînement</field>
		<field name="res_model">adk.gym.program</field>
		<field name="view_mode">kanban,list,form</field>
	</record>

	<record id="view_gym_program_kanban" model="ir.ui.view">
		<field name="name">adk.gym.program.kanban</field>
		<field name="model">adk.gym.program</field>
		<field name="arch" type="xml">
			<kanban class="o_kanban_small_column" default_group_by="state" sample="1">
				<field name="id"/>
				<field name="name"/>
				<field name="member_ids"/>
				<field name="coach_ids"/>
				<field name="goal_ids" widget="many2many_tags"/>
				<field name="state"/>
				<field name="line_count"/>
				<field name="color"/>
				<templates>
					<t t-name="kanban-box">
						<div t-attf-class="oe_kanban_global_click oe_kanban_card #{kanban_color(record.color.raw_value)}">
							<div class="o_kanban_record_top">
								<strong class="o_kanban_record_title">
									<field name="name"/>
								</strong>
							</div>
							<div class="o_kanban_record_body">
								<div><i class="fa fa-user me-1"/><field name="member_ids" widget="many2many_tags"/></div>
								<div t-if="record.coach_ids.raw_value.length"><i class="fa fa-user-md me-1"/><field name="coach_ids" widget="many2many_tags"/></div>
								<span t-if="record.goal_ids.raw_value.length" class="badge text-bg-light"><field name="goal_ids" widget="many2many_tags"/></span>
							</div>
							<div class="o_kanban_record_bottom mt-2">
								<span class="badge text-bg-info"><field name="line_count"/> exercices</span>
							</div>
						</div>
					</t>
				</templates>
			</kanban>
		</field>
	</record>

	<record id="view_gym_program_list" model="ir.ui.view">
		<field name="name">adk.gym.program.list</field>
		<field name="model">adk.gym.program</field>
		<field name="arch" type="xml">
			<list string="Programmes">
				<field name="name"/>
				<field name="member_ids" widget="many2many_tags"/>
				<field name="coach_ids" widget="many2many_tags"/>
				<field name="goal_ids" widget="many2many_tags"/>
				<field name="date_start"/>
				<field name="date_end"/>
				<field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'in_progress'"/>
			</list>
		</field>
	</record>

	<record id="view_gym_program_form" model="ir.ui.view">
		<field name="name">adk.gym.program.form</field>
		<field name="model">adk.gym.program</field>
		<field name="arch" type="xml">
			<form>
				<header>
					<button name="action_start" string="Démarrer" type="object" class="oe_highlight" invisible="state != 'draft'"/>
					<button name="action_done" string="Terminer" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
					<button name="action_reset_draft" string="Repasser en brouillon" type="object" invisible="state == 'draft'"/>
					<field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
				</header>
				<sheet>
					<div class="oe_title">
						<h1>
							<field name="name" placeholder="ex: Programme Prise de Masse - Semaine 1"/>
						</h1>
					</div>
					<group>
						<group>
							<field name="member_ids" widget="many2many_tags" options="{'no_create': False}"/>
							<field name="coach_ids" widget="many2many_tags" options="{'no_create': False}"/>
							<field name="goal_ids" widget="many2many_tags" options="{'no_create': False}"/>
						</group>
						<group>
							<field name="date_start"/>
							<field name="date_end"/>
							<field name="active" invisible="1"/>
						</group>
					</group>
					<notebook>
						<page string="Exercices">
							<field name="line_ids">
								<list editable="bottom">
									<field name="sequence" widget="handle"/>
									<field name="exercise_name"/>
									<field name="sets"/>
									<field name="reps"/>
									<field name="weight"/>
									<field name="rest_time"/>
								</list>
							</field>
						</page>
						<page string="Observations">
							<field name="notes"/>
						</page>
					</notebook>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>

	<record id="view_gym_program_search" model="ir.ui.view">
		<field name="name">adk.gym.program.search</field>
		<field name="model">adk.gym.program</field>
		<field name="arch" type="xml">
			<search>
				<field name="name"/>
				<field name="member_ids"/>
				<field name="coach_ids"/>
				<filter string="En cours" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
				<filter string="Terminés" name="filter_done" domain="[('state', '=', 'done')]"/>
				<group expand="0" string="Grouper par">
					<filter string="État" name="group_by_state" context="{'group_by': 'state'}"/>
					<filter string="Coach" name="group_by_coach" context="{'group_by': 'coach_ids'}"/>
					<filter string="Objectif" name="group_by_goal" context="{'group_by': 'goal_ids'}"/>
				</group>
			</search>
		</field>
	</record>

	<!-- ========================================================== -->
	<!-- TABLEAU DE BORD (KPIs) -->
	<!-- ========================================================== -->
	<record id="view_gym_dashboard_form" model="ir.ui.view">
		<field name="name">adk.gym.dashboard.form</field>
		<field name="model">adk.gym.dashboard</field>
		<field name="arch" type="xml">
			<form string="Tableau de Bord">
				<div class="o_form_statusbar" style="justify-content:space-between; border:none;">
					<widget name="gym_dashboard_autorefresh"/>
					<button name="action_refresh" type="object" string="Actualiser" icon="fa-refresh" class="btn-secondary"/>
				</div>
				<sheet>
					<div class="oe_title text-center mb-4">
						<h1 style="font-weight:700;"><i class="fa fa-dashboard text-primary me-2"/>Tableau de Bord ADK GYM</h1>
						<p class="text-muted">Vue d'ensemble en temps réel de votre salle de sport</p>
					</div>

					<!-- ==================== SECTION MEMBRES ==================== -->
					<h5 class="text-uppercase text-muted mt-3 mb-2" style="letter-spacing:1px;"><i class="fa fa-users me-2"/>Membres</h5>
					<div class="row g-3">
						<div class="col-3">
							<div class="card border-0 shadow-sm h-100" style="background:linear-gradient(135deg,#4e73df 0%,#3654b0 100%); color:white;">
								<div class="card-body text-center py-4">
									<i class="fa fa-user-circle fa-2x mb-2" style="opacity:0.85;"/>
									<h2 class="mb-0 text-white"><field name="count_active_members" class="text-white" readonly="1" nolabel="1"/></h2>
									<span style="opacity:0.9;">Membres Actifs</span>
								</div>
							</div>
						</div>
						<div class="col-3">
							<div class="card border-0 shadow-sm h-100" style="background:linear-gradient(135deg,#e74a3b 0%,#c0392b 100%); color:white;">
								<div class="card-body text-center py-4">
									<i class="fa fa-user-times fa-2x mb-2" style="opacity:0.85;"/>
									<h2 class="mb-0 text-white"><field name="count_expired_members" class="text-white" readonly="1" nolabel="1"/></h2>
									<span style="opacity:0.9;">Membres Expirés</span>
								</div>
							</div>
						</div>
						<div class="col-3">
							<div class="card border-0 shadow-sm h-100" style="background:linear-gradient(135deg,#1cc88a 0%,#169b6b 100%); color:white;">
								<div class="card-body text-center py-4">
									<i class="fa fa-user-plus fa-2x mb-2" style="opacity:0.85;"/>
									<h2 class="mb-0 text-white"><field name="count_new_members_month" class="text-white" readonly="1" nolabel="1"/></h2>
									<span style="opacity:0.9;">Nouveaux ce mois</span>
								</div>
							</div>
						</div>
						<div class="col-3">
							<div class="card border-0 shadow-sm h-100" style="background:linear-gradient(135deg,#f6c23e 0%,#dda520 100%); color:white;">
								<div class="card-body text-center py-4">
									<i class="fa fa-clock-o fa-2x mb-2" style="opacity:0.85;"/>
									<h2 class="mb-0 text-white"><field name="count_subscriptions_expiring_soon" class="text-white" readonly="1" nolabel="1"/></h2>
									<span style="opacity:0.9;">Expirent sous 7j</span>
								</div>
							</div>
						</div>
					</div>

					<!-- ==================== SECTION STRUCTURE ==================== -->
					<h5 class="text-uppercase text-muted mt-4 mb-2" style="letter-spacing:1px;"><i class="fa fa-building me-2"/>Structure &amp; Inventaire</h5>
					<div class="row g-3">
						<div class="col-3">
							<div class="card border-0 shadow-sm h-100 bg-light">
								<div class="card-body text-center py-4">
									<i class="fa fa-user-md fa-2x mb-2 text-primary"/>
									<h2 class="mb-0"><field name="count_coaches" readonly="1" nolabel="1"/></h2>
									<span class="text-muted">Coachs</span>
								</div>
							</div>
						</div>
						<div class="col-3">
							<div class="card border-0 shadow-sm h-100 bg-light">
								<div class="card-body text-center py-4">
									<i class="fa fa-building-o fa-2x mb-2 text-secondary"/>
									<h2 class="mb-0"><field name="count_salles" readonly="1" nolabel="1"/></h2>
									<span class="text-muted">Salles</span>
								</div>
							</div>
						</div>
						<div class="col-3">
							<div class="card border-0 shadow-sm h-100 bg-light">
								<div class="card-body text-center py-4">
									<i class="fa fa-wrench fa-2x mb-2 text-danger"/>
									<h2 class="mb-0"><field name="count_equipment_damaged" readonly="1" nolabel="1"/></h2>
									<span class="text-muted">Équip. en panne</span>
								</div>
							</div>
						</div>
						<div class="col-3">
							<div class="card border-0 shadow-sm h-100 bg-light">
								<div class="card-body text-center py-4">
									<i class="fa fa-shopping-cart fa-2x mb-2 text-success"/>
									<h2 class="mb-0"><field name="count_products_sold" readonly="1" nolabel="1"/></h2>
									<span class="text-muted">Produits vendus</span>
								</div>
							</div>
						</div>
					</div>

					<!-- ==================== SECTION FINANCE ==================== -->
					<h5 class="text-uppercase text-muted mt-4 mb-2" style="letter-spacing:1px;"><i class="fa fa-money me-2"/>Finance</h5>
					<div class="row g-3">
						<div class="col-6">
							<div class="card border-0 shadow-sm h-100" style="background:linear-gradient(135deg,#2c3e50 0%,#1a252f 100%); color:white;">
								<div class="card-body py-4 d-flex align-items-center">
									<i class="fa fa-line-chart fa-3x me-3" style="opacity:0.6;"/>
									<div>
										<h2 class="mb-0 text-white"><field name="total_revenue" class="text-white" readonly="1"/> F CFA</h2>
										<span style="opacity:0.85;">Revenu total (abonnements actifs)</span>
									</div>
								</div>
							</div>
						</div>
						<div class="col-6">
							<div class="card border-0 shadow-sm h-100" style="background:linear-gradient(135deg,#6f42c1 0%,#4e2a91 100%); color:white;">
								<div class="card-body py-4 d-flex align-items-center">
									<i class="fa fa-calendar-check-o fa-3x me-3" style="opacity:0.6;"/>
									<div>
										<h2 class="mb-0 text-white"><field name="total_revenue_month" class="text-white" readonly="1"/> F CFA</h2>
										<span style="opacity:0.85;">Revenu généré ce mois</span>
									</div>
								</div>
							</div>
						</div>
					</div>

					<div class="mt-4 text-center">
						<button name="action_view_active_members" type="object" string="Voir les membres actifs" class="btn btn-outline-primary me-2" icon="fa-users"/>
						<button name="action_view_expiring_subscriptions" type="object" string="Voir les abonnements qui expirent" class="btn btn-outline-warning" icon="fa-exclamation-triangle"/>
					</div>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_gym_dashboard" model="ir.actions.server">
		<field name="name">Tableau de Bord</field>
		<field name="model_id" ref="model_adk_gym_dashboard"/>
		<field name="state">code</field>
		<field name="code">action = model.action_open_dashboard()</field>
	</record>
</odoo>
