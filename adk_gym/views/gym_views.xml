<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<!-- ========================================================== -->
	<!-- BOUTIQUE / PRODUITS -->
	<!-- ========================================================== -->
	<record id="action_gym_products" model="ir.actions.act_window">
		<field name="name">Boutique / Produits</field>
		<field name="res_model">product.template</field>
		<field name="view_mode">kanban,list,form</field>
		<field name="context">{'default_sale_ok': 1}</field>
		<field name="domain">[('sale_ok', '=', True)]</field>
	</record>

	<!-- ========================================================== -->
	<!-- COACHS -->
	<!-- ========================================================== -->
	<record id="action_gym_coach" model="ir.actions.act_window">
		<field name="name">Coachs</field>
		<field name="res_model">adk.gym.coach</field>
		<field name="view_mode">kanban,list,form</field>
		<field name="context">{'search_default_filter_active': 1}</field>
	</record>

	<record id="view_gym_coach_kanban" model="ir.ui.view">
		<field name="name">adk.gym.coach.kanban</field>
		<field name="model">adk.gym.coach</field>
		<field name="arch" type="xml">
			<kanban class="o_kanban_mobile" sample="1">
				<field name="id"/>
				<field name="name"/>
				<field name="image_1920"/>
				<field name="specialty"/>
				<field name="availability"/>
				<field name="member_count"/>
				<templates>
					<t t-name="kanban-box">
						<div class="oe_kanban_global_click oe_kanban_card">
							<div class="d-flex align-items-center mb-2">
								<img t-att-src="kanban_image('adk.gym.coach', 'image_1920', record.id.raw_value)"
									 class="rounded-circle me-2"
									 style="width:48px;height:48px;object-fit:cover;flex-shrink:0;"
									 alt="Photo"/>
								<strong class="o_kanban_record_title fs-5">
									<field name="name"/>
								</strong>
							</div>
							<div class="oe_kanban_details">
								<ul class="ps-0 mb-0" style="list-style:none;">
									<li t-if="record.specialty.raw_value">
										<i class="fa fa-star text-warning me-1"/><field name="specialty"/>
									</li>
									<li>
										<i class="fa fa-users text-primary me-1"/><field name="member_count"/> membres suivis
									</li>
								</ul>
								<div class="o_kanban_record_bottom mt-2">
									<span t-if="record.availability.raw_value == 'available'" class="badge rounded-pill text-bg-success">Disponible</span>
									<span t-elif="record.availability.raw_value == 'busy'" class="badge rounded-pill text-bg-warning">Occupé</span>
									<span t-else="" class="badge rounded-pill text-bg-secondary">En congé</span>
								</div>
							</div>
						</div>
					</t>
				</templates>
			</kanban>
		</field>
	</record>

	<record id="view_gym_coach_list" model="ir.ui.view">
		<field name="name">adk.gym.coach.list</field>
		<field name="model">adk.gym.coach</field>
		<field name="arch" type="xml">
			<list string="Coachs" sample="1">
				<field name="name"/>
				<field name="specialty"/>
				<field name="phone"/>
				<field name="member_count"/>
				<field name="availability" widget="badge" decoration-success="availability == 'available'" decoration-warning="availability == 'busy'"/>
			</list>
		</field>
	</record>

	<record id="view_gym_coach_form" model="ir.ui.view">
		<field name="name">adk.gym.coach.form</field>
		<field name="model">adk.gym.coach</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<div class="oe_button_box" name="button_box">
						<button name="action_view_members" type="object" class="oe_stat_button" icon="fa-users">
							<field name="member_count" string="Membres" widget="statinfo"/>
						</button>
						<button name="action_view_programs" type="object" class="oe_stat_button" icon="fa-clipboard">
							<field name="program_count" string="Programmes" widget="statinfo"/>
						</button>
					</div>
					<field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128', 'zoom': true}"/>
					<div class="oe_title">
						<label for="name" string="Nom du coach"/>
						<h1>
							<field name="name" placeholder="Nom du coach..."/>
						</h1>
					</div>
					<group>
						<group string="Expertise &amp; Lieu">
							<field name="active" invisible="1"/>
							<field name="specialty"/>
							<field name="qualification"/>
							<field name="experience_years"/>
							<field name="availability" widget="radio" options="{'horizontal': true}"/>
							<field name="localisation"/>
						</group>
						<group string="Identité &amp; Contact">
							<field name="gender" widget="radio" options="{'horizontal': true}"/>
							<field name="dob"/>
							<field name="age" readonly="1" force_save="1"/>
							<field name="phone" widget="phone"/>
							<field name="email" widget="email"/>
						</group>
					</group>
					<group>
						<field name="salle_ids" widget="many2many_tags"/>
					</group>
					<notebook>
						<page string="Biographie">
							<field name="bio" placeholder="Présentation du coach..."/>
						</page>
						<page string="Membres suivis">
							<field name="member_ids" readonly="1">
								<list>
									<field name="name"/>
									<field name="phone"/>
									<field name="practice_level_id"/>
								</list>
							</field>
						</page>
						<page string="Programmes encadrés">
							<field name="program_ids" readonly="1">
								<list>
									<field name="name"/>
									<field name="member_ids" widget="many2many_tags"/>
									<field name="goal_ids" widget="many2many_tags"/>
									<field name="date_start"/>
									<field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'in_progress'"/>
								</list>
							</field>
						</page>
					</notebook>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>

	<record id="view_gym_coach_search" model="ir.ui.view">
		<field name="name">adk.gym.coach.search</field>
		<field name="model">adk.gym.coach</field>
		<field name="arch" type="xml">
			<search>
				<field name="name"/>
				<field name="specialty"/>
				<filter string="Actifs" name="filter_active" domain="[('active', '=', True)]"/>
				<filter string="Disponibles" name="filter_available" domain="[('availability', '=', 'available')]"/>
				<group expand="0" string="Grouper par">
					<filter string="Disponibilité" name="group_by_availability" context="{'group_by': 'availability'}"/>
					<filter string="Spécialité" name="group_by_specialty" context="{'group_by': 'specialty'}"/>
				</group>
			</search>
		</field>
	</record>

	<!-- ========================================================== -->
	<!-- SALLES -->
	<!-- ========================================================== -->
	<record id="action_gym_salle" model="ir.actions.act_window">
		<field name="name">Salles / Clubs</field>
		<field name="res_model">adk.gym.salle</field>
		<field name="view_mode">kanban,list,form</field>
	</record>

	<record id="view_gym_salle_kanban" model="ir.ui.view">
		<field name="name">adk.gym.salle.kanban</field>
		<field name="model">adk.gym.salle</field>
		<field name="arch" type="xml">
			<kanban class="o_kanban_mobile" sample="1">
				<field name="id"/>
				<field name="name"/>
				<field name="city"/>
				<field name="district"/>
				<field name="country_id"/>
				<field name="member_count"/>
				<field name="equipment_count"/>
				<field name="image_1920"/>
				<templates>
					<t t-name="kanban-box">
						<div class="oe_kanban_global_click oe_kanban_card">
							<div class="o_kanban_record_top d-flex align-items-center">
								<img t-att-src="kanban_image('adk.gym.salle', 'image_1920', record.id.raw_value)"
									 class="rounded me-2"
									 style="width:56px;height:56px;object-fit:cover;flex-shrink:0;"
									 alt="Salle"/>
								<div class="o_kanban_record_headings">
									<strong class="o_kanban_record_title fs-5">
										<i class="fa fa-building me-1"/><field name="name"/>
									</strong>
									<span class="text-muted">
										<t t-if="record.district.raw_value"><field name="district"/>, </t>
										<field name="city"/>
										<t t-if="record.country_id.raw_value"> (<field name="country_id"/>)</t>
									</span>
								</div>
							</div>
							<div class="o_kanban_record_bottom mt-2">
								<div class="oe_kanban_bottom_left">
									<span class="badge text-bg-primary me-1"><field name="member_count"/> membres</span>
									<span class="badge text-bg-secondary"><field name="equipment_count"/> équipements</span>
								</div>
							</div>
						</div>
					</t>
				</templates>
			</kanban>
		</field>
	</record>

	<record id="view_gym_salle_list" model="ir.ui.view">
		<field name="name">adk.gym.salle.list</field>
		<field name="model">adk.gym.salle</field>
		<field name="arch" type="xml">
			<list string="Salles">
				<field name="name"/>
				<field name="city"/>
				<field name="district"/>
				<field name="country_id"/>
				<field name="phone"/>
				<field name="member_count"/>
				<field name="equipment_count"/>
			</list>
		</field>
	</record>

	<record id="view_gym_salle_form" model="ir.ui.view">
		<field name="name">adk.gym.salle.form</field>
		<field name="model">adk.gym.salle</field>
		<field name="arch" type="xml">
			<form>
				<header>
					<button name="%(adk_gym.action_report_gym_salle_fiche)d" string="Imprimer Fiche Salle" type="action" class="oe_highlight"/>
				</header>
				<sheet>
					<div class="oe_button_box" name="button_box">
						<button name="action_view_members" type="object" class="oe_stat_button" icon="fa-users">
							<field name="member_count" string="Membres" widget="statinfo"/>
						</button>
					</div>
					<field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128', 'zoom': true}"/>
					<div class="oe_title">
						<label for="name" string="Nom de la salle"/>
						<h1>
							<field name="name"/>
						</h1>
					</div>
					<group>
						<group string="Coordonnées">
							<!-- Pays / région / ville / quartier : modifiables uniquement par
							     l'Administrateur Gym une fois la salle créée (changement
							     structurel). Le Responsable les voit en lecture seule. -->
							<field name="country_id" readonly="id and not is_gym_admin" options="{'no_create': True}"/>
							<field name="state_id" readonly="id and not is_gym_admin" options="{'no_create': True}"/>
							<field name="city" readonly="id and not is_gym_admin" placeholder="ex: Douala"/>
							<field name="district" readonly="id and not is_gym_admin" placeholder="ex: Akwa"/>
							<field name="phone" widget="phone"/>
							<field name="email" widget="email"/>
							<field name="website" widget="url"/>
						</group>
						<group string="Paramètres">
							<field name="capacity"/>
							<field name="opening_hours_display" readonly="1" string="Horaires (résumé)"/>
							<field name="is_gym_admin" invisible="1"/>
							<field name="active" invisible="1"/>
						</group>
					</group>
					<field name="description" placeholder="Description de la salle..."/>
					<notebook>
						<page string="Horaires d'ouverture">
							<div class="alert alert-info d-flex align-items-center" role="alert" style="margin-bottom:12px;">
								<span>Sélectionnez un jour, puis choisissez l'heure d'ouverture et de fermeture à l'aide du sélecteur d'heure. Cochez « Fermé » pour un jour sans activité.</span>
							</div>
							<button name="action_generate_default_hours" type="object"
									string="Générer automatiquement la semaine (Lun-Ven 08h-21h, Sam 09h-18h, Dim fermé)"
									class="btn-secondary mb-2" icon="fa-magic"/>
							<field name="hours_ids">
								<list editable="bottom">
									<field name="weekday"/>
									<field name="is_closed"/>
									<field name="opening_time" widget="float_time" invisible="is_closed"/>
									<field name="closing_time" widget="float_time" invisible="is_closed"/>
								</list>
							</field>
						</page>
						<page string="Membres rattachés">
							<field name="member_ids" readonly="1">
								<list>
									<field name="name"/>
									<field name="phone"/>
								</list>
							</field>
						</page>
						<page string="Coachs">
							<field name="coach_ids" widget="many2many_tags"/>
						</page>
						<page string="Inventaire Équipements">
							<field name="equipment_ids">
								<list editable="bottom">
									<field name="salle_id" column_invisible="1"/>
									<field name="equipment_id" options="{'no_create': False}"/>
									<field name="code"/>
									<field name="quantity"/>
									<field name="state" widget="badge" decoration-success="state == 'good'" decoration-warning="state == 'maintenance'" decoration-danger="state == 'damaged'"/>
								</list>
							</field>
						</page>
					</notebook>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>

	<!-- ========================================================== -->
	<!-- DISCIPLINES / ACTIVITÉS -->
	<!-- ========================================================== -->
	<record id="action_gym_activity" model="ir.actions.act_window">
		<field name="name">Disciplines et Activités</field>
		<field name="res_model">adk.gym.activity</field>
		<field name="view_mode">kanban,list,form</field>
	</record>

	<record id="view_gym_activity_kanban" model="ir.ui.view">
		<field name="name">adk.gym.activity.kanban</field>
		<field name="model">adk.gym.activity</field>
		<field name="arch" type="xml">
			<kanban class="o_kanban_mobile" sample="1">
				<field name="id"/>
				<field name="name"/>
				<field name="duration_minutes"/>
				<field name="subscription_count"/>
				<templates>
					<t t-name="kanban-box">
						<div class="oe_kanban_global_click oe_kanban_card">
							<div class="o_kanban_record_top">
								<strong class="o_kanban_record_title fs-5">
									<i class="fa fa-heartbeat me-1 text-danger"/><field name="name"/>
								</strong>
							</div>
							<div class="o_kanban_record_body">
								<span class="text-muted"><field name="duration_minutes"/> min / séance</span>
							</div>
							<div class="o_kanban_record_bottom mt-2">
								<span class="badge text-bg-info"><field name="subscription_count"/> abonnements</span>
							</div>
						</div>
					</t>
				</templates>
			</kanban>
		</field>
	</record>

	<record id="view_gym_activity_list" model="ir.ui.view">
		<field name="name">adk.gym.activity.list</field>
		<field name="model">adk.gym.activity</field>
		<field name="arch" type="xml">
			<list string="Disciplines">
				<field name="name"/>
				<field name="duration_minutes"/>
				<field name="max_participants"/>
				<field name="subscription_count"/>
			</list>
		</field>
	</record>

	<record id="view_gym_activity_form" model="ir.ui.view">
		<field name="name">adk.gym.activity.form</field>
		<field name="model">adk.gym.activity</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<div class="oe_button_box" name="button_box">
						<button name="%(adk_gym.action_gym_subscription)d" type="action" class="oe_stat_button" icon="fa-ticket"
								context="{'search_default_discipline_ids': id}">
							<field name="subscription_count" string="Abonnements" widget="statinfo"/>
						</button>
					</div>
					<div class="oe_title">
						<h1>
							<field name="name" placeholder="ex: Musculation"/>
						</h1>
					</div>
					<group>
						<group>
							<field name="duration_minutes"/>
							<field name="max_participants"/>
							<field name="default_price"/>
						</group>
						<group>
							<field name="active" invisible="1"/>
							<field name="equipment_ids" widget="many2many_tags"/>
						</group>
					</group>
					<field name="description" placeholder="Description de la discipline..."/>
				</sheet>
			</form>
		</field>
	</record>

	<!-- ========================================================== -->
	<!-- ÉQUIPEMENTS -->
	<!-- Un article (ex: "Masse") est créé UNE SEULE FOIS. L'onglet "Présence par -->
	<!-- salle" liste ensuite les salles qui l'utilisent, chacune avec sa propre -->
	<!-- quantité, son propre état et, si besoin, son propre identifiant unique. -->
	<!-- ========================================================== -->
	<record id="view_gym_equipment_kanban" model="ir.ui.view">
		<field name="name">adk.gym.equipment.kanban</field>
		<field name="model">adk.gym.equipment</field>
		<field name="arch" type="xml">
			<kanban class="o_kanban_mobile" sample="1">
				<field name="id"/>
				<field name="name"/>
				<field name="brand"/>
				<field name="salle_count"/>
				<field name="total_quantity"/>
				<field name="has_unusable_stock"/>
				<field name="image_1920"/>
				<templates>
					<t t-name="kanban-box">
						<div class="oe_kanban_global_click oe_kanban_card">
							<div class="o_kanban_record_top">
								<div class="o_kanban_image me-2">
									<img t-if="record.image_1920.raw_value" t-att-src="kanban_image('adk.gym.equipment', 'image_1920', record.id.raw_value)" style="width:32px; height:32px; object-fit:cover; border-radius:4px;"/>
									<i t-else="" class="fa fa-cogs fa-lg text-muted"/>
								</div>
								<strong class="o_kanban_record_title">
									<field name="name"/>
								</strong>
							</div>
							<div class="o_kanban_record_body">
								<div t-if="record.brand.raw_value">Marque: <field name="brand"/></div>
								<div>Présent dans <strong><field name="salle_count"/></strong> salle(s)</div>
								<div>Quantité totale: <strong><field name="total_quantity"/></strong></div>
							</div>
							<div class="o_kanban_record_bottom mt-2">
								<span t-if="record.has_unusable_stock.raw_value" class="badge rounded-pill text-bg-warning">Alerte état</span>
								<span t-else="" class="badge rounded-pill text-bg-success">Bon état</span>
							</div>
						</div>
					</t>
				</templates>
			</kanban>
		</field>
	</record>

	<record id="view_gym_equipment_list" model="ir.ui.view">
		<field name="name">adk.gym.equipment.list</field>
		<field name="model">adk.gym.equipment</field>
		<field name="arch" type="xml">
			<list string="Équipements" decoration-warning="has_unusable_stock">
				<field name="name"/>
				<field name="brand" optional="hide"/>
				<field name="salle_count" string="Nb Salles"/>
				<field name="salle_ids" widget="many2many_tags" optional="show"/>
				<field name="total_quantity" string="Quantité totale"/>
				<field name="has_unusable_stock" string="Alerte état" widget="boolean_toggle" optional="hide"/>
			</list>
		</field>
	</record>

	<record id="view_gym_equipment_search" model="ir.ui.view">
		<field name="name">adk.gym.equipment.search</field>
		<field name="model">adk.gym.equipment</field>
		<field name="arch" type="xml">
			<search>
				<field name="name"/>
				<field name="brand"/>
				<field name="salle_ids"/>
				<filter string="Avec alerte état" name="filter_unusable" domain="[('has_unusable_stock', '=', True)]"/>
				<group expand="0" string="Grouper par">
					<filter string="Salle" name="group_by_salle" context="{'group_by': 'salle_ids'}"/>
				</group>
			</search>
		</field>
	</record>

	<record id="action_gym_equipment" model="ir.actions.act_window">
		<field name="name">Outils et Équipements</field>
		<field name="res_model">adk.gym.equipment</field>
		<field name="view_mode">kanban,list,form</field>
		<field name="search_view_id" ref="view_gym_equipment_search"/>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">Créez votre premier article</p>
			<p>Un article n'est créé qu'une seule fois, même s'il est présent dans plusieurs salles : renseignez ensuite, depuis sa fiche, la liste des salles qui en disposent.</p>
		</field>
	</record>

	<record id="view_gym_equipment_form" model="ir.ui.view">
		<field name="name">adk.gym.equipment.form</field>
		<field name="model">adk.gym.equipment</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<div class="oe_button_box" name="button_box">
						<button name="action_view_stock_movements" type="object" class="oe_stat_button" icon="fa-building">
							<field name="salle_count" string="Salles" widget="statinfo"/>
						</button>
					</div>
					<field name="has_unusable_stock" invisible="1"/>
					<field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
					<div class="oe_title">
						<h1>
							<field name="name" placeholder="ex: Masse"/>
						</h1>
					</div>
					<group>
						<group>
							<field name="brand"/>
							<field name="total_quantity" readonly="1"/>
						</group>
						<group>
							<field name="active" invisible="1"/>
						</group>
					</group>
					<notebook>
						<page string="Présence par salle">
							<p class="text-muted">
								Renseignez ici chaque salle qui possède cet article, avec sa propre quantité et son propre état. Un même article n'est jamais dupliqué : il suffit d'ajouter une ligne par salle.
							</p>
							<field name="stock_ids">
								<list editable="bottom" decoration-danger="state == 'damaged'" decoration-warning="state == 'maintenance'">
									<field name="salle_id" options="{'no_create': False}"/>
									<field name="code"/>
									<field name="quantity"/>
									<field name="purchase_date"/>
									<field name="purchase_price"/>
									<field name="state" widget="badge" decoration-success="state == 'good'" decoration-warning="state == 'maintenance'" decoration-danger="state == 'damaged'"/>
								</list>
								<form>
									<header>
										<button name="action_stock_in" type="object" string="Entrée de stock" class="btn-primary" icon="fa-arrow-circle-down"/>
										<button name="action_stock_out" type="object" string="Sortie de stock" class="btn-secondary" icon="fa-arrow-circle-up"/>
										<field name="state" widget="statusbar" statusbar_visible="good,maintenance,damaged,retired" options="{'clickable': '1'}"/>
									</header>
									<sheet>
										<field name="is_unusable" invisible="1"/>
										<group>
											<group>
												<field name="salle_id" options="{'no_create': False}"/>
												<field name="code"/>
												<field name="quantity"/>
											</group>
											<group>
												<field name="purchase_date"/>
												<field name="purchase_price"/>
												<field name="active" invisible="1"/>
											</group>
										</group>
										<notebook>
											<page string="Observations">
												<field name="notes" placeholder="Observations..."/>
											</page>
											<page string="Mouvements de Stock">
												<field name="movement_ids">
													<list editable="bottom">
														<field name="date"/>
														<field name="movement_type" widget="badge" decoration-success="movement_type == 'in'" decoration-danger="movement_type == 'out'"/>
														<field name="quantity"/>
														<field name="reason"/>
														<field name="notes"/>
													</list>
												</field>
											</page>
										</notebook>
									</sheet>
								</form>
							</field>
						</page>
						<page string="Observations">
							<field name="notes" placeholder="Observations générales sur l'article..."/>
						</page>
					</notebook>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>

	<!-- ========================================================== -->
	<!-- MOUVEMENTS DE STOCK OUTILS (RAPPORT : ÉTAT DE STOCK) -->
	<!-- ========================================================== -->
	<record id="view_gym_equipment_movement_list" model="ir.ui.view">
		<field name="name">adk.gym.equipment.movement.list</field>
		<field name="model">adk.gym.equipment.movement</field>
		<field name="arch" type="xml">
			<list string="État de Stock des Outils" decoration-danger="movement_type == 'out'" decoration-success="movement_type == 'in'">
				<field name="equipment_id"/>
				<field name="salle_id"/>
				<field name="date"/>
				<field name="movement_type" widget="badge" decoration-success="movement_type == 'in'" decoration-danger="movement_type == 'out'"/>
				<field name="quantity"/>
				<field name="reason"/>
				<field name="equipment_state" widget="badge" decoration-success="equipment_state == 'good'" decoration-warning="equipment_state == 'maintenance'" decoration-danger="equipment_state == 'damaged'"/>
				<field name="notes" optional="hide"/>
			</list>
		</field>
	</record>

	<record id="view_gym_equipment_movement_search" model="ir.ui.view">
		<field name="name">adk.gym.equipment.movement.search</field>
		<field name="model">adk.gym.equipment.movement</field>
		<field name="arch" type="xml">
			<search>
				<field name="equipment_id"/>
				<field name="salle_id"/>
				<filter string="Entrées" name="filter_in" domain="[('movement_type', '=', 'in')]"/>
				<filter string="Sorties" name="filter_out" domain="[('movement_type', '=', 'out')]"/>
				<separator/>
				<filter string="Outils inutilisables" name="filter_unusable" domain="[('equipment_state', 'in', ['maintenance', 'damaged', 'retired'])]"/>
				<group expand="0" string="Grouper par">
					<filter string="Outil" name="group_by_equipment" context="{'group_by': 'equipment_id'}"/>
					<filter string="Salle" name="group_by_salle" context="{'group_by': 'salle_id'}"/>
					<filter string="Type de mouvement" name="group_by_type" context="{'group_by': 'movement_type'}"/>
					<filter string="État de l'outil" name="group_by_state" context="{'group_by': 'equipment_state'}"/>
				</group>
			</search>
		</field>
	</record>

	<record id="action_gym_equipment_stock_report" model="ir.actions.act_window">
		<field name="name">État de Stock des Outils</field>
		<field name="res_model">adk.gym.equipment.movement</field>
		<field name="view_mode">list,pivot</field>
		<field name="search_view_id" ref="view_gym_equipment_movement_search"/>
		<field name="context">{'search_default_group_by_equipment': 1}</field>
	</record>

	<!-- ========================================================== -->
	<!-- OBJECTIFS SPORTIFS -->
