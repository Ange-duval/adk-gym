<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<!-- ========================================================== -->
	<!-- ACTION -->
	<!-- ========================================================== -->
	<record id="action_gym_member" model="ir.actions.act_window">
		<field name="name">Membres</field>
		<field name="res_model">adk.gym.member</field>
		<field name="view_mode">kanban,list,form</field>
		<field name="context">{'search_default_filter_active': 1}</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">Créez votre premier membre</p>
			<p>Gérez ici les fiches complètes de vos adhérents : morphologie, objectifs, santé et abonnements.</p>
		</field>
	</record>

	<!-- ========================================================== -->
	<!-- KANBAN -->
	<!-- ========================================================== -->
	<record id="view_gym_member_kanban" model="ir.ui.view">
		<field name="name">adk.gym.member.kanban</field>
		<field name="model">adk.gym.member</field>
		<field name="arch" type="xml">
			<kanban class="o_kanban_mobile" sample="1">
				<field name="id"/>
				<field name="name"/>
				<field name="image_1920"/>
				<field name="localisation"/>
				<field name="age"/>
				<field name="salle_id"/>
				<field name="membership_status"/>
				<field name="active_subscription_id"/>
				<field name="color"/>
				<templates>
					<t t-name="kanban-box">
						<div t-attf-class="oe_kanban_global_click oe_kanban_card #{kanban_color(record.color.raw_value)}">
							<div class="o_kanban_record_top d-flex align-items-center">
								<img t-att-src="kanban_image('adk.gym.member', 'image_1920', record.id.raw_value)"
									 class="rounded-circle me-2"
									 style="width:48px;height:48px;object-fit:cover;flex-shrink:0;"
									 alt="Photo"/>
								<div class="oe_kanban_details d-flex flex-column justify-content-between">
									<div>
										<div class="o_kanban_record_top">
											<div class="o_kanban_record_headings">
												<strong class="o_kanban_record_title fs-5">
													<field name="name"/>
												</strong>
											</div>
											<div class="o_dropdown_kanban dropdown" groups="adk_gym.group_gym_manager">
												<a role="button" class="dropdown-toggle o-no-caret btn" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
													<span class="fa fa-ellipsis-v"/>
												</a>
												<div class="dropdown-menu" role="menu">
													<a role="menuitem" type="edit" class="dropdown-item">Modifier</a>
													<a role="menuitem" type="delete" class="dropdown-item">Supprimer</a>
												</div>
											</div>
										</div>
										<ul class="ps-0 mb-0" style="list-style:none;">
											<li t-if="record.localisation.raw_value">
												<i class="fa fa-map-marker text-primary me-1"/><field name="localisation"/>
											</li>
											<li t-if="record.salle_id.raw_value">
												<i class="fa fa-building text-secondary me-1"/><field name="salle_id"/>
											</li>
											<li>
												<i class="fa fa-birthday-cake text-info me-1"/><field name="age"/> ans
											</li>
											<li t-if="record.active_subscription_id.raw_value" class="mt-1">
												<i class="fa fa-calendar text-success me-1"/><field name="active_subscription_id"/>
											</li>
										</ul>
									</div>
									<div class="o_kanban_record_bottom mt-2">
										<div class="oe_kanban_bottom_left">
											<span t-if="record.membership_status.raw_value == 'active'" class="badge rounded-pill text-bg-success">Actif</span>
											<span t-elif="record.membership_status.raw_value == 'expired'" class="badge rounded-pill text-bg-danger">Expiré</span>
											<span t-else="" class="badge rounded-pill text-bg-secondary">Aucun abonnement</span>
										</div>
									</div>
								</div>
							</div>
						</div>
					</t>
				</templates>
			</kanban>
		</field>
	</record>

	<!-- ========================================================== -->
	<!-- LIST -->
	<!-- ========================================================== -->
	<record id="view_gym_member_list" model="ir.ui.view">
		<field name="name">adk.gym.member.list</field>
		<field name="model">adk.gym.member</field>
		<field name="arch" type="xml">
			<list string="Membres" sample="1" decoration-muted="not active">
				<field name="name"/>
				<field name="phone"/>
				<field name="salle_id"/>
				<field name="coach_id" optional="show"/>
				<field name="age" optional="show"/>
				<field name="registration_date" optional="hide"/>
				<field name="active" column_invisible="True"/>
				<field name="membership_status" widget="badge" decoration-success="membership_status == 'active'" decoration-danger="membership_status == 'expired'" decoration-muted="membership_status == 'none'"/>
			</list>
		</field>
	</record>

	<!-- ========================================================== -->
	<!-- FORM -->
	<!-- ========================================================== -->
	<record id="view_gym_member_form" model="ir.ui.view">
		<field name="name">adk.gym.member.form</field>
		<field name="model">adk.gym.member</field>
		<field name="arch" type="xml">
			<form string="Membre">
				<header>
					<button name="action_create_subscription" string="Créer Abonnement" type="object" class="oe_highlight"/>
					<button name="action_create_partner" string="Créer Contact" type="object" invisible="partner_id != False"/>
					<button name="%(adk_gym.action_report_registration_form)d" string="Imprimer Fiche" type="action" class="btn-secondary"/>
					<widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
				</header>
				<sheet>
					<div class="oe_button_box" name="button_box">
						<button name="action_view_subscriptions" type="object" class="oe_stat_button" icon="fa-ticket">
							<field name="subscription_count" string="Abonnements" widget="statinfo"/>
						</button>
					</div>
					<field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128', 'zoom': true}"/>
					<div class="oe_title">
						<label for="name" string="Nom complet"/>
						<h1>
							<field name="name" placeholder="ex: Ange Duval Kambeu"/>
						</h1>
						<field name="membership_status" widget="badge" decoration-success="membership_status == 'active'" decoration-danger="membership_status == 'expired'"/>
					</div>
					<group>
						<group string="Identité">
							<field name="active" invisible="1"/>
							<field name="gender" widget="radio" options="{'horizontal': true}"/>
							<field name="dob"/>
							<field name="age" readonly="1" force_save="1"/>
							<field name="place_of_birth"/>
						</group>
						<group string="Contact &amp; Liens">
							<field name="phone" widget="phone"/>
							<field name="email" widget="email"/>
							<field name="localisation"/>
							<field name="partner_id" options="{'no_create': False, 'no_open': False}"/>
							<field name="salle_id" options="{'no_create': False, 'no_open': False}"/>
							<field name="coach_id" options="{'no_create': False, 'no_open': False}"/>
						</group>
						<group string="Physique">
							<field name="taille"/>
							<field name="poids"/>
							<field name="imc" readonly="1"/>
							<field name="imc_category" readonly="1"/>
						</group>
						<group string="Santé &amp; Objectif">
							<field name="has_medical_condition" widget="radio" options="{'horizontal': true}"/>
							<field name="medical_details" invisible="has_medical_condition == 'non'"/>
							<field name="objective_ids" widget="many2many_tags" options="{'no_create': False}"/>
							<field name="practice_level_id" options="{'no_create': False, 'no_open': False}"/>
						</group>
					</group>
					<notebook>
						<page string="Historique Abonnements" name="subscriptions">
							<field name="subscription_ids" readonly="1">
								<list decoration-success="state == 'active'" decoration-danger="state == 'expired'" decoration-muted="state == 'cancelled'">
									<field name="name"/>
									<field name="type"/>
									<field name="date_start"/>
									<field name="date_end"/>
									<field name="total_amount"/>
									<field name="state" widget="badge" decoration-success="state == 'active'" decoration-danger="state == 'expired'"/>
								</list>
							</field>
						</page>
						<page string="Programmes d'entraînement" name="programs">
							<field name="program_ids">
								<list>
									<field name="name"/>
									<field name="coach_ids" widget="many2many_tags"/>
									<field name="goal_ids" widget="many2many_tags"/>
									<field name="date_start"/>
									<field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'in_progress'"/>
								</list>
							</field>
						</page>
					</notebook>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>

	<!-- ========================================================== -->
	<!-- SEARCH -->
	<!-- ========================================================== -->
	<record id="view_gym_member_search" model="ir.ui.view">
		<field name="name">adk.gym.member.search</field>
		<field name="model">adk.gym.member</field>
		<field name="arch" type="xml">
			<search string="Rechercher un Membre">
				<field name="name" string="Membre" filter_domain="['|', ('name', 'ilike', self), ('phone', 'ilike', self)]"/>
				<field name="salle_id"/>
				<field name="coach_id"/>
				<field name="practice_level_id"/>
				<filter string="Actifs" name="filter_active" domain="[('active', '=', True)]"/>
				<filter string="Abonnement Actif" name="filter_member_active" domain="[('membership_status', '=', 'active')]"/>
				<filter string="Abonnement Expiré" name="filter_member_expired" domain="[('membership_status', '=', 'expired')]"/>
				<filter string="Sans abonnement" name="filter_member_none" domain="[('membership_status', '=', 'none')]"/>
				<filter string="Alerte médicale" name="filter_medical" domain="[('has_medical_condition', '=', 'oui')]"/>
				<separator/>
				<filter string="Archivés" name="filter_archived" domain="[('active', '=', False)]"/>
				<group expand="0" string="Grouper par">
					<filter string="Salle" name="group_by_salle" context="{'group_by': 'salle_id'}"/>
					<filter string="Coach" name="group_by_coach" context="{'group_by': 'coach_id'}"/>
					<filter string="Statut Abonnement" name="group_by_status" context="{'group_by': 'membership_status'}"/>
					<filter string="Genre" name="group_by_gender" context="{'group_by': 'gender'}"/>
				</group>
			</search>
		</field>
	</record>
</odoo>
